; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NEXUS ARCADE"
config/version="0.9.1"
config/description="NEXUS ARCADE: 75 mixed-reality games, utilities and creative tools for Meta Quest 3 with Check for Updates built in."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

BugReporter="*res://scripts/shared/bug_reporter.gd"
VisualFX="*res://scripts/shared/visual_fx.gd"
AILib="*res://scripts/shared/ai_lib.gd"
UIKit="*res://scripts/shared/ui_kit.gd"
AudioKit="*res://scripts/shared/audio_kit.gd"
JuiceFX="*res://scripts/shared/juice_fx.gd"
PassthroughFX="*res://scripts/shared/passthrough_fx.gd"
MoodLUT="*res://scripts/shared/mood_lut.gd"
PauseExit="*res://scripts/shared/pause_exit.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0, 0, 0, 0)

[xr]

openxr/enabled=true
; v0.8.0: pin the Quest action map explicitly. The engine default already
; points here, but an explicit entry survives engine-default changes.
; WITHOUT a loaded map, is_button_pressed("trigger_click") /
; get_float("trigger") / is_button_pressed("menu_button") never resolve on
; device: lasers render from pose only and clicks never fire (stuck menu).
openxr/default_action_map="res://openxr_action_map.tres"
openxr/reference_space=2
openxr/extensions/hand_tracking=true
openxr/extensions/hand_interaction_profile=true
openxr/extensions/meta/passthrough=true
openxr/extensions/meta/hand_tracking_mesh=true
openxr/extensions/meta/spatial_entity=true
; v0.9.0 (AI_API_ROADMAP, verified against the 5.1.0 vendor binary):
; - simultaneous_hands_and_controllers: controllers + bare hands, no OS mode switch
; - body_tracking: XR_FB_body_tracking / XR_META_body_tracking_full_body
;   (action path /user/body_tracker -> Godot XRBodyTracker)
; - environment_depth: per-pixel real-world occlusion (VisualFX depth hook,
;   gameplay objects only, toggleable in the hub footer)
; - render_model: show the user's actual controller models
openxr/extensions/meta/simultaneous_hands_and_controllers=true
openxr/extensions/meta/body_tracking=true
openxr/extensions/meta/environment_depth=true
openxr/extensions/meta/render_model=true
